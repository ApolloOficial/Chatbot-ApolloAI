# API
PUBLIC_BASE_URL=https://apolloai.example.invalid
CORS_ORIGINS=https://apollo.example.invalid
AUTH_REQUIRED=true
APOLLOAI_API_TOKEN=
MAX_CONTENT_LENGTH=32768
LOG_LEVEL=INFO

# Modelos de IA
AI_PROVIDER=bedrock
AI_MODEL=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
# Use credenciais temporárias somente fora de uma carga AWS com identidade IAM.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
GROQ_API_KEY=
# Para Gemini, GOOGLE_API_KEY também aceita o alias GEMINI_API_KEY fora do Compose.
GOOGLE_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# MongoDB
MONGODB_URI=mongodb+srv://SEU_USUARIO:SUA_SENHA@SEU_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=apollo_ai
MONGODB_REQUIRED=true
MONGODB_TIMEOUT_MS=10000

# Redis
REDIS_URL=rediss://default:SUA_SENHA@SEU_ENDPOINT:SUA_PORTA/0
REDIS_ENABLED=true
REDIS_REQUIRED=true
REDIS_TIMEOUT_SECONDS=5

# MCP
MCP_REQUIRED=true
MCP_SERVER_COMMAND=python -m app.mcp_server
MCP_TIMEOUT_SECONDS=12

# Qdrant e RAG
QDRANT_URL=https://seu-cluster.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=768
QDRANT_INDEX_BATCH_SIZE=50
QDRANT_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_MIN_SCORE=0.08

# Memória e retenção
SUMMARY_AFTER_MESSAGES=12
MAX_CONTEXT_MESSAGES=8
MEMORY_LOOKBACK_SESSIONS=3
RETENTION_DAYS=180

# Estimativas de custo e retorno
PRICE_INPUT_PER_MILLION=0
PRICE_OUTPUT_PER_MILLION=0
AVG_MESSAGES_PER_USER=5
AVG_INPUT_TOKENS=700
AVG_OUTPUT_TOKENS=350
AVG_AGENTS_PER_REQUEST=4
AVG_RAG_QUERIES=1
ESTIMATED_RESOLUTION_RATE=0.75
ESTIMATED_MINUTES_SAVED=5
TECHNICIAN_HOURLY_COST=0
